# 이 파일은 '설정 항목의 목록과 형식'을 보여주는 예시입니다.
# 복사해서 .env 를 만든 뒤 실제 값을 채우세요:  cp .env.example .env
# .env 는 Git 에 커밋되지 않습니다(.gitignore). 실제 키/비밀번호/사내 주소는 이 파일에 절대 넣지 마세요.

# 세션 미들웨어(로그인) 서명 키. 운영에서는 반드시 안전한 랜덤 값으로 교체하세요.
#   생성 예: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET_KEY=change-me-local-dev-secret

# OpenAI API (JD 추천 / 이력서 분석에 사용)
# 실제 API key 는 .env 에만 직접 작성하세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PostgreSQL 접속정보 (실제 값은 직접 작성한 .env 에 넣으세요)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=resume_ai
DB_USER=postgres
DB_PASSWORD=
DB_SCHEMA=resume_ai
# DATABASE_URL 이 있으면 DB_* 보다 우선 사용됩니다.
DATABASE_URL=

# Google OAuth files
# 값은 '파일 경로'입니다. credential/token 내용 자체를 .env 에 넣지 마세요.
#   - Docker/운영: 컨테이너 내부 절대경로 (예: /app/secrets/google/credentials.json)
#   - 로컬 개발  : 상대경로는 프로젝트 루트 기준으로 해석됩니다.
#   - 비워두면 프로젝트 루트의 credentials.json / token.json 으로 fallback 합니다.
GOOGLE_CREDENTIALS_PATH=secrets/google/credentials.json
GOOGLE_TOKEN_PATH=secrets/google/token.json

# -----------------------------------------------------------------------------
# 수집 대상 회사 (target company)
# -----------------------------------------------------------------------------
# 이 앱은 채용 플랫폼 검색 결과에서 '특정 회사'의 신규 공고만 골라 등록합니다.
# 회사명은 코드에 기본값이 없습니다. 아래를 설정하지 않으면 수집/공고검증 기능은
# 명확한 에러로 실패하고(fail-closed), 나머지 기능은 정상 동작합니다.
#
# TARGET_COMPANY_NAME     : 대표 표기 1개 (로그/응답에 노출)
# TARGET_COMPANY_NAMES    : 공백 제거 후 exact 매칭할 허용 표기 목록(쉼표 구분).
#                           상호가 비슷한 다른 회사를 걸러내기 위해 exact 매칭만 사용합니다.
#                           미설정 시 TARGET_COMPANY_NAME 을 사용합니다.
# TARGET_COMPANY_KEYWORDS : 공고 본문/HTML 에서 회사 결속을 확인할 부분일치 키워드(쉼표 구분).
#                           너무 짧은 키워드는 무관한 공고를 통과시킬 수 있으니 주의하세요.
# (아래는 형식 예시용 가상 회사명입니다. 실제 값으로 바꿔 쓰세요.)
TARGET_COMPANY_NAME=샘플(주)
TARGET_COMPANY_NAMES=샘플(주),샘플주식회사
TARGET_COMPANY_KEYWORDS=샘플(주),(주)샘플,주식회사 샘플

# 사람인 검색 → 대상 회사 신규 공고 자동 수집 배치 (수동 실행 API + 스케줄러)
# 스케줄러 자동 실행은 코드상 주석 처리 상태입니다(운영 반영 시 해제).
# SARAMIN_SEARCH_URL : 회사명으로 검색한 결과 페이지 URL(회사명이 쿼리스트링에 포함되므로 기본값 없음).
SARAMIN_SEARCH_URL=
SARAMIN_SEARCH_KEYWORD=샘플
SARAMIN_DISCOVERY_ENABLED=false

# 잡코리아 검색 → 대상 회사 신규 공고 자동 수집 배치 (사람인과 동일 구조)
JOBKOREA_SEARCH_URL=
JOBKOREA_SEARCH_KEYWORD=샘플(주)
JOBKOREA_DISCOVERY_ENABLED=false

# -----------------------------------------------------------------------------
# 부서(조직도) 데이터
# -----------------------------------------------------------------------------
# 저장소에는 가상 조직도 샘플만 포함됩니다. 실제 조직도를 쓰려면 같은 스키마의 파일을
# 준비해 경로를 지정하세요. 실제 조직도 파일은 Git 에 커밋하지 마세요.
DEPT_JSON_PATH=data/dummy/departments.sample.json

# 좌측 메뉴 'Drive 바로가기' 링크. 비워두면 메뉴에서 숨겨집니다.
DRIVE_SHORTCUT_URL=

# -----------------------------------------------------------------------------
# SSL CA 번들 (선택 — SSL inspection 이 있는 사내망에서만 필요)
# -----------------------------------------------------------------------------
# certs/ 에 사설 Root CA(.crt)를 두면 Docker 빌드 시 시스템 번들에 병합됩니다.
# 미설정 시 코드가 /etc/ssl/certs/ca-certificates.crt 를 기본값으로 사용합니다.
# SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# -----------------------------------------------------------------------------
# Celery / Redis (비동기 작업 큐 — 공고 JD 분석 / 이력서 분석 worker)
# -----------------------------------------------------------------------------
# Docker Compose 내부에서는 redis 서비스명을 사용합니다.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# 기본 큐 이름
CELERY_TASK_DEFAULT_QUEUE=job_discovery

# Celery timezone
CELERY_TIMEZONE=Asia/Seoul

# Worker 동작 설정
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true

# 로컬에서 Redis를 직접 띄우고 worker를 실행하는 경우 예시:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 주의: 실제 Redis 비밀번호/운영 URL 은 .env 에만 넣으세요(.env.example 금지).

# -----------------------------------------------------------------------------
# 개발용 더미 계정 비밀번호 (scripts/hash_existing_dummy_passwords.py 전용)
# -----------------------------------------------------------------------------
# 로컬 시드 계정의 평문 비밀번호를 bcrypt 로 전환할 때만 사용합니다.
# 형식: login_id:password 를 쉼표로 구분. 운영 환경에서는 설정하지 마세요.
# DUMMY_ACCOUNT_PASSWORDS=admin:change-me-1,hr.team:change-me-2

# 컨테이너 8000 포트를 호스트의 어느 포트로 노출할지 (docker-compose)
APP_HOST_PORT=28080
