# 세션 미들웨어(로그인) 서명 키. 운영에서는 반드시 안전한 랜덤 값으로 교체하세요.
# (.env.example 에는 개발용 예시만 둡니다)
SESSION_SECRET_KEY=change-me-local-dev-secret

# OpenAI API (JD 추천 / 이력서 분석에 사용)
# 실제 API key 는 .env 에만 직접 작성하세요. (.env.example 에는 예시 값만 둡니다)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# PostgreSQL 접속정보 (실제 값은 직접 작성한 .env 에 넣으세요. .env 는 Git 에 커밋하지 않습니다)
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_SCHEMA=
# DATABASE_URL 이 있으면 DB_* 보다 우선 사용됩니다.
DATABASE_URL=

# Google OAuth files
# Docker/production recommended paths (컨테이너 내부 절대경로)
GOOGLE_CREDENTIALS_PATH=secrets/google/credentials.json
GOOGLE_TOKEN_PATH=secrets/google/token.json
# 로컬 개발 시: 상대경로(예: secrets/google/credentials.json)는 프로젝트 루트 기준으로 해석됩니다.
#             값을 비워두면 프로젝트 루트의 credentials.json / token.json 으로 fallback 합니다.
# 주의: 실제 credential/token 값은 .env 에 넣지 말고 파일로만 두세요. (경로만 설정)

# 사람인 '디딤' 검색 → 디딤(주) 신규 공고 자동 수집 배치 (수동 실행 API + 스케줄러)
# 스케줄러 자동 실행은 코드상 주석 처리 상태입니다(운영 반영 시 해제). 아래 값은 미설정 시 코드 기본값을 사용합니다.
# SARAMIN_DIDIM_SEARCH_URL=   # 비워두면 코드 기본값(디딤 검색 URL) 사용. 빈 문자열로 설정하면 안 됩니다.
SARAMIN_DIDIM_KEYWORD=디딤
SARAMIN_DIDIM_COMPANY_NAME=디딤(주)
SARAMIN_DISCOVERY_ENABLED=false

# -----------------------------------------------------------------------------
# Celery / Redis (비동기 작업 큐 — 1차: 사람인 공고 JD 분석 worker)
# -----------------------------------------------------------------------------
# Docker Compose 내부에서는 redis 서비스명을 사용합니다.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# 기본 큐 이름
CELERY_TASK_DEFAULT_QUEUE=job_discovery

# Celery timezone
CELERY_TIMEZONE=Asia/Seoul

# Worker 동작 설정
CELERY_WORKER_PREFETCH_MULTIPLIER=1
CELERY_TASK_ACKS_LATE=true

# 로컬에서 Redis를 직접 띄우고 worker를 실행하는 경우 예시:
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
# 주의: 실제 Redis 비밀번호/운영 URL 은 .env 에만 넣으세요(.env.example 금지).

